<h1>Nos Produits</h1>

<div class="produits-grid">
  <% @produits.each do |produit| %>
    <div class="produit-card">
      <% if produit.image.attached? %>
        <%= image_tag produit.image, alt: produit.name, class: "produit-image" %>
      <% else %>
        <p>Pas d'image</p>
      <% end %>

      <h2><%= link_to produit.name, produit_path(produit) %></h2>
      <p><%= number_to_currency(produit.price, unit: "€") %></p>

      <!-- BOUTON : Ajouter au panier -->
      <button
        class="btn-panier"
        data-controller="cart"
        data-action="click->cart#ajouter"
        data-produit-id="<%= produit.id %>"
        data-produit-nom="<%= produit.name %>"
        data-produit-prix="<%= produit.price %>">
        Ajouter au panier
      </button>
    </div>
  <% end %>
</div>

<div data-controller="cart">
  <p>Stimulus devrait écrire dans la console (produits#index)</p>
</div>

